-- PF023 (PF - 1): the level milestone items' sheets live in CosmeticLevelArt (generated and drift-checked by
-- work/pf023/ingame/registry.mjs); each joins here once its upload lands. Soft: a harness without it loads as before.
do
    local ok,level=pcall(function() return require(script.Parent.CosmeticLevelArt) end)
    if ok and type(level)=="table" and type(level.items)=="table" then
        for id,e in level.items do
            if e.frames and e.image~="" and Sheets[id]==nil then Sheets[id]={image=e.image,width=e.width,height=e.height,pixels=e.pixels} end
        end
    end
end
-- PIVOT Glacier (PF - 1): the Glacier pack's sheets (CosmeticPackArt, generated by work/pivot/glacier/registry.mjs). Soft.
do
    local ok,pack=pcall(function() return require(script.Parent.CosmeticPackArt) end)
    if ok and type(pack)=="table" and type(pack.items)=="table" then
        for id,e in pack.items do
            if e.frames and e.image~="" and Sheets[id]==nil then Sheets[id]={image=e.image,width=e.width,height=e.height,pixels=e.pixels} end
        end
    end
end
return table.freeze(Sheets)
