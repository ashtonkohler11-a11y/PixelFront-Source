-- PF017-D: every building icon name (City, CityGlyph, TeamHUDCityIconWhite, …)
-- and its "_White" variant resolves to the uploaded in-game map sprite, so
-- runtime binds and Edit-mode authoring both get the uncropped original.
local Building=require(script.Parent.BuildingIcons)
for legacy,canonical in Building.Aliases do
    local upload=Building.Uploads[canonical]
    if upload then Assets[legacy]=upload.image;Assets[legacy.."_White"]=upload.image end
end
return table.freeze(Assets)
